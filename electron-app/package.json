{
  "name": "automatismos-lousada-producao",
  "version": "1.0.0",
  "private": true,
  "description": "App de produção (fábrica) da Automatismos Lousada — janela fina que abre a página /producao do site.",
  "author": "Automatismos Lousada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "pt.automatismoslousada.producao",
    "productName": "Automatismos Lousada - Producao",
    "icon": "icon.ico",
    "afterPack": "./afterPack.js",
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "icon.png",
      "config.json",
      "config.example.json"
    ]
  }
}
